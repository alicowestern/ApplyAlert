generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
  imports       Import[]
  extractions   Extraction[]
  reminders     Reminder[]
}

model Opportunity {
  id             String    @id @default(uuid())
  userId         String
  title          String
  organization   String?
  opportunityType String
  summary        String?
  location       String?
  
  // FundingInfo flattened
  fundingIsFunded Boolean?
  fundingDetails  String?

  applicationUrl String?

  status         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  appliedAt      DateTime?
  archivedAt     DateTime?

  // Relations
  user           User              @relation(fields: [userId], references: [id])
  source         OpportunitySource?
  deadline       OpportunityDeadline?
  reminders      Reminder[]

  @@index([userId, status])
  @@index([userId, archivedAt])
  @@index([userId, createdAt])
}

model OpportunitySource {
  id            String   @id @default(uuid())
  opportunityId String   @unique
  type          String
  url           String?
  rawText       String?
  fileName      String?
  mimeType      String?
  fileRef       String?
  importedAt    DateTime @default(now())

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model OpportunityDeadline {
  id            String   @id @default(uuid())
  opportunityId String   @unique
  kind          String
  originalText  String?
  
  // DATE_ONLY preserves the calendar date string without timezone interference
  localDate     String?
  localTime     String?
  timezone      String?
  utcInstant    DateTime?
  
  confidence    Float    @default(1.0)
  userConfirmed Boolean  @default(false)
  evidence      String?
  alternativeCandidates String[] // Stored as scalar list (PostgreSQL specific)

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model Import {
  id          String   @id @default(uuid())
  userId      String
  inputType   String   // URL, TEXT, IMAGE, PDF
  status      String   // PENDING, PROCESSING, READY_FOR_EXTRACTION, FAILED, CANCELLED

  // URL imports
  originalUrl String?
  finalUrl    String?

  // Text imports
  originalText String?

  // File imports (Image/PDF)
  fileName    String?  // Original filename (metadata only)
  mimeType    String?
  fileSize    Int?
  storageKey  String?  // Server-generated key in ObjectStorage

  // Processing results
  normalizedText String?  // Extracted/normalized text
  contentHash    String?  // SHA-256 of normalized content

  // Error tracking
  errorCode       String?
  errorMessage    String?

  // Timestamps
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id])
  extraction Extraction?

  @@index([userId, status])
  @@index([createdAt])
  @@index([contentHash])
}

model Extraction {
  id        String   @id @default(uuid())
  importId  String   @unique
  userId    String
  status    String   // PENDING, PROCESSING, READY_FOR_REVIEW, FAILED, CANCELLED

  provider      String?
  model         String?
  promptVersion String?
  schemaVersion String?

  result          Json?
  confidenceLevel String?
  warnings        String[] // Stored as scalar list (PostgreSQL specific)

  errorCode       String?
  errorMessage    String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?

  // Relations
  import Import @relation(fields: [importId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([createdAt])
}

model Reminder {
  id               String    @id @default(uuid())
  userId           String
  opportunityId    String
  type             String    // THIRTY_DAYS, FOURTEEN_DAYS, SEVEN_DAYS, THREE_DAYS, ONE_DAY, DEADLINE_DAY, CUSTOM
  status           String    // PENDING, SCHEDULED, DELIVERED, CANCELLED, SKIPPED, FAILED
  channel          String    // LOCAL, PUSH
  scheduledFor     DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  deviceScheduleId String?

  // Relations
  user        User        @relation(fields: [userId], references: [id])
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([opportunityId, status])
  @@index([scheduledFor, status])
}
